Algoritmo serie
	definir cantidadterminos, contadornumeros, termino Como Entero
	imprimir "ingrese la cantidad de terminos a generar " 
	Leer cantidadterminos
	termino=1 
	Para  contadornumeros=1 Hasta cantidadterminos-1 Con Paso 1 Hacer
		imprimir termino 
		termino=termino+2
	Fin Para
	Imprimir termino 
FinAlgoritmo
